// MovieMatch data model.
// Content-based recommender: users rate titles (movies/series) they've seen,
// rate actors/directors, and set genre/country weights. Recommendations score
// unrated titles against those signals.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum TitleType {
  MOVIE
  SERIES
}

// Audience reach: how widely-seen/mass-market a title is, derived from
// popularity/vote count (primary) and budget (reinforcement) -- see
// classifyAudienceTier in src/lib/titleAttributes.ts. Independent from
// BudgetTier: reach and production spend are correlated but not the same
// thing (a low-budget film can go viral; a mega-budget one can flop).
enum AudienceTier {
  MAINSTREAM
  INDIE
}

// Pure production-scale signal, from budget alone (movies only -- TMDB
// doesn't report series budgets).
enum BudgetTier {
  MEGA
  SMALL
}

enum RuntimeBucket {
  SHORT
  MEDIUM
  LONG
}

// Raw TMDB vote-count tier -- see classifyPopularityRange in
// src/lib/titleAttributes.ts. Deliberately much lower thresholds than
// AudienceTier: a separate signal, not a restatement of mainstream/indie.
enum PopularityRange {
  LOW
  MID
  HIGH
}

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  passwordHash          String
  name                  String?
  country               String? // ISO 3166-1 code -- which country's streaming catalog to show
  originalTitles        Boolean   @default(false) // show each title's original-language name instead of the Spanish one
  createdAt             DateTime  @default(now())
  onboardingCompletedAt DateTime?
  homeVisitedAt         DateTime? // last time the home screen was opened -- used for the "new since your last visit" count
  tourSeenAt            DateTime? // set once the home coach-mark tutorial has been shown/skipped -- null means show it on next home visit
  // Personal, stable invite code for "agregar como amigo" -- shared via link,
  // same idea as Group.inviteCode but per-user instead of per-group since a
  // friendship isn't scoped to any one group.
  friendCode            String    @unique @default(cuid())

  titleRatings       UserTitleRating[]
  personRatings      UserPersonRating[]
  genrePreferences   UserGenrePreference[]
  countryPreferences UserCountryPreference[]
  typePreferences    UserTypePreference[]
  audiencePreferences UserAudiencePreference[]
  budgetPreferences   UserBudgetPreference[]
  runtimePreferences  UserRuntimePreference[]
  popularityPreferences UserPopularityPreference[]
  wishlist           Wishlist[]
  onboardingChoices  OnboardingChoice[]
  ownedGroups        Group[]       @relation("GroupOwner")
  groupMemberships   GroupMember[]
  savedFilters       SavedFilter[]
  pageToursSeen      UserPageTourSeen[]
  friendshipsAsA        Friendship[]         @relation("FriendshipA")
  friendshipsAsB        Friendship[]         @relation("FriendshipB")
  sentRecommendations     SentRecommendation[] @relation("SentRecFrom")
  receivedRecommendations SentRecommendation[] @relation("SentRecTo")
}

// A friendship is one row per pair, regardless of who sent the invite --
// userAId is always the lexicographically smaller id (see lib/friends.ts),
// so there's exactly one row per pair and no risk of a mirrored duplicate.
model Friendship {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  createdAt DateTime @default(now())
  userA     User     @relation("FriendshipA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User     @relation("FriendshipB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}

// "Te recomendaron X" -- a friend pushing one specific title at you, not the
// joint/pooled recommendations Group already does. seenAt is set in bulk the
// first time the recipient opens /friends (not per-item), just enough to
// drive an unread-count badge without over-engineering read tracking.
model SentRecommendation {
  id         String    @id @default(cuid())
  fromUserId String
  toUserId   String
  titleId    String
  createdAt  DateTime  @default(now())
  seenAt     DateTime?

  fromUser User  @relation("SentRecFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User  @relation("SentRecTo", fields: [toUserId], references: [id], onDelete: Cascade)
  title    Title @relation(fields: [titleId], references: [id], onDelete: Cascade)

  @@index([toUserId])
  @@index([fromUserId])
  @@index([titleId])
}

// Per-page coach-mark tutorials (recomendaciones, ficha de título, ficha de
// persona, catálogo, novedades, mi lista, vs, calificar vistas, calificar
// populares) -- separate from the home tour above (User.tourSeenAt), which
// predates this and works fine as-is. One row per page a user has already
// seen the tutorial for; absence of a row means "show it".
model UserPageTourSeen {
  id      String   @id @default(cuid())
  userId  String
  pageKey String
  seenAt  DateTime @default(now())
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, pageKey])
  @@index([userId])
}

// One "which do you like more" round from onboarding -- titleAId/titleBId
// are shown, winnerId is which one was picked. Not a rating (we don't know
// they actually watched either one), just a preference-inference signal and
// a log of what's already been shown, so onboarding doesn't repeat itself
// and can pick genres it hasn't covered yet.
model OnboardingChoice {
  id        String   @id @default(cuid())
  userId    String
  titleAId  String
  titleBId  String
  winnerId  String
  skipped   Boolean  @default(false) // true = "no vi ninguna de las dos" -- winnerId is meaningless, no preference bump
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// "Linked accounts": a group of users who get joint recommendations that
// factor in everyone's tastes and exclude anything any member has seen.
model Group {
  id         String   @id @default(cuid())
  name       String?
  inviteCode String   @unique @default(cuid())
  ownerId    String
  createdAt  DateTime @default(now())

  owner   User          @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members GroupMember[]
}

model GroupMember {
  id       String   @id @default(cuid())
  groupId  String
  userId   String
  joinedAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

model Title {
  id             String    @id @default(cuid())
  // Not globally unique on its own: TMDB movie ids and TV ids are separate
  // number spaces, so a movie and a series can legitimately share the same
  // tmdbId. Uniqueness only holds combined with type.
  tmdbId         Int
  type           TitleType
  name           String
  originalName   String?
  overview       String?
  releaseYear    Int?
  releaseDate    DateTime? // full date (movies) -- used to flag "still in theaters"
  posterPath     String?
  backdropPath   String?
  popularity     Float?
  voteAverage    Float?
  voteCount      Int? // TMDB vote count -- used as the "masividad" filter
  budget         Int? // USD, movies only (TMDB doesn't report it for series)
  runtime        Int? // minutes -- movie runtime, or a representative episode runtime for series
  seasonsCount   Int? // series only -- total number of seasons
  episodesCount  Int? // series only -- total number of episodes across all seasons
  nextEpisodeAirDate DateTime? // series only -- next episode's scheduled air date, null if none scheduled
  status         String? // series only -- raw TMDB status: "Returning Series", "Planned", "In Production", "Ended", "Canceled", "Pilot"
  inProduction   Boolean? // series only -- actively producing new episodes right now
  lastAirDate    DateTime? // series only -- most recently aired episode's date
  collectionId   Int? // TMDB "belongs_to_collection" id, movies only -- lets sequels/trilogies
  // (Lord of the Rings 1-2-3, the Harry Potter films...) count as one unit of
  // evidence instead of N when inferring an actor/director preference, so a
  // single franchise binge can't manufacture a preference on its own.
  originCountry  String? // primary ISO 3166-1 country code
  onboardingRank Int? // lower = shown earlier during onboarding ("top 100")
  // YouTube video key for the best trailer TMDB has, fetched lazily the
  // first time someone opens this title's detail page (see /api/titles/[id],
  // same pattern as Person.detailsFetchedAt). Null key with a non-null
  // trailerFetchedAt means "we checked, TMDB has none" -- distinct from
  // never having checked, so we don't refetch on every single page view.
  trailerKey       String?
  trailerFetchedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  genres    TitleGenre[]
  cast      TitleCast[]
  crew      TitleCrew[]
  ratings   UserTitleRating[]
  providers TitleProvider[]
  similar   TitleSimilar[]
  wishlist  Wishlist[]
  sentRecommendations SentRecommendation[]

  @@unique([tmdbId, type])
  @@index([tmdbId])
  @@index([onboardingRank])
  @@index([type])
  @@index([releaseYear])
  @@index([voteAverage])
  @@index([voteCount])
  // `orderBy: popularity desc` is the single most common query shape in the
  // app -- the recommendation candidate pool, search, the import/backfill
  // batches, onboarding's popularity fallback -- all of it, on every
  // request. Without this the catalog gets sorted from scratch every time,
  // getting slower as more titles get imported.
  @@index([popularity])
}

// A streaming service (Netflix, HBO Max, etc) per TMDB/JustWatch.
model Provider {
  id       Int    @id // TMDB provider_id
  name     String
  logoPath String?

  titles TitleProvider[]
}

// Where a title streams (subscription/"flatrate" only), per country -- the
// same title is on different services in different countries.
model TitleProvider {
  titleId     String
  providerId  Int
  countryCode String
  title       Title    @relation(fields: [titleId], references: [id], onDelete: Cascade)
  provider    Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@id([titleId, providerId, countryCode])
  @@index([countryCode])
}

// "People who liked this also liked that" -- TMDB's own recommendations for
// a title (fetched alongside credits/watch-providers, no extra API cost),
// used to boost candidates related to titles the user rated highly. Not a
// relation to another Title row: the related title might not be in our
// catalog (yet), so it's resolved by tmdbId+type lookup at scoring time.
model TitleSimilar {
  titleId       String
  relatedTmdbId Int
  relatedType   TitleType
  rank          Int // position in TMDB's response, 0 = most relevant
  title         Title     @relation(fields: [titleId], references: [id], onDelete: Cascade)

  @@id([titleId, relatedTmdbId, relatedType])
  @@index([relatedTmdbId, relatedType])
}

// "La voy a ver": titles a user wants to watch, saved from a recommendation
// or the catalog for later. Excluded from future recommendations same as a
// rating; converts into one (and disappears from here) once marked as seen.
model Wishlist {
  id      String   @id @default(cuid())
  userId  String
  titleId String
  addedAt DateTime @default(now())
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title   Title    @relation(fields: [titleId], references: [id], onDelete: Cascade)

  @@unique([userId, titleId])
  @@index([userId])
}

model Genre {
  id   Int    @id // TMDB genre id
  name String @unique

  titles      TitleGenre[]
  preferences UserGenrePreference[]
}

model TitleGenre {
  titleId String
  genreId Int
  title   Title  @relation(fields: [titleId], references: [id], onDelete: Cascade)
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([titleId, genreId])
  // The composite primary key above only serves "titleId -> its genres"
  // lookups (titleId leads it) -- filtering "titles that have genre X"
  // (explore/recommendations/wishlist's genre filter) needs genreId as its
  // own leading column, which nothing else here provides.
  @@index([genreId])
}

model Person {
  id                 String  @id @default(cuid())
  tmdbId             Int     @unique
  name               String
  profilePath        String?
  knownForDepartment String?
  biography          String?
  birthday           DateTime?
  deathday           DateTime?
  placeOfBirth       String?
  // Set once we've pulled biography/birthday/etc from TMDB for this person
  // (see /api/people/[id]) -- null means "never tried yet, fetch on next
  // view", distinct from an empty biography (which TMDB genuinely has
  // nothing for) so we don't re-fetch on every single page load.
  detailsFetchedAt   DateTime?

  castRoles TitleCast[]
  crewRoles TitleCrew[]
  ratings   UserPersonRating[]

  @@index([knownForDepartment])
}

model TitleCast {
  titleId   String
  personId  String
  character String?
  order     Int     @default(0)
  title     Title   @relation(fields: [titleId], references: [id], onDelete: Cascade)
  person    Person  @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([titleId, personId])
  @@index([personId])
}

// Directors / creators (job = "Director" for movies, "Creator" for series)
model TitleCrew {
  titleId  String
  personId String
  job      String
  title    Title  @relation(fields: [titleId], references: [id], onDelete: Cascade)
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([titleId, personId, job])
  @@index([personId])
}

model UserTitleRating {
  id      String   @id @default(cuid())
  userId  String
  titleId String
  seen    Boolean  @default(true)
  score   Int? // 1-5 stars, null when seen=false or seen but not yet rated
  // Only meaningful when seen=false: true = "no me interesa" (explicit
  // rejection, excluded from future recommendations for good), false =
  // neutral "no la he visto" (e.g. a VS swap-out, or Explore's "No la vi")
  // -- still a perfectly good recommendation candidate. Always false when
  // seen=true (can't reject something you've watched).
  notInterested Boolean @default(false)
  // Series only ("WATCHING" | "FINISHED" | "ABANDONED"), only meaningful
  // when seen=true -- captured alongside marking a series as seen. Null for
  // movies, and for series marked seen without going through a UI flow that
  // asks (e.g. a "vs" win records seen=true but doesn't ask this).
  watchProgress String?
  ratedAt DateTime @default(now())
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title   Title    @relation(fields: [titleId], references: [id], onDelete: Cascade)

  @@unique([userId, titleId])
  @@index([userId])
}

// Manual actor/director adjustment (set from "Mis gustos", shared between
// both roles since Person covers both) -- ADDED to the derived score, not a
// replacement. `score` is an accumulated total of every +1/-1 click, not a
// bounded scale. The onboarding "rate people you know" step also writes
// here directly (an absolute set, not an increment) as a starting point.
// The derived component comes from accumulated "vs" wins + 4-5-star
// ratings requiring several corroborating titles (see
// computeDerivedPreferences in src/lib/preferenceCounts.ts) -- this table
// only ever holds the manual layer on top of that.
model UserPersonRating {
  id       String @id @default(cuid())
  userId   String
  personId String
  score    Int // accumulated manual adjustment, added to the derived actor/director score
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([userId, personId])
  @@index([userId])
}

// Manual adjustment tables below (genre/country/type/audience/budget/
// runtime/popularity) all follow the same pattern: `weight` is an
// accumulated total of every +1/-1 click from "Mis gustos", ADDED to
// (never replacing) the dimension's derived score from
// computeDerivedPreferences -- see preferenceCounts.ts.

model UserGenrePreference {
  id      String @id @default(cuid())
  userId  String
  genreId Int
  weight  Int
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@unique([userId, genreId])
  @@index([userId])
}

model UserCountryPreference {
  id          String @id @default(cuid())
  userId      String
  countryCode String
  weight      Int
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, countryCode])
  @@index([userId])
}

model UserTypePreference {
  id     String    @id @default(cuid())
  userId String
  type   TitleType
  weight Int
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
}

model UserAudiencePreference {
  id     String       @id @default(cuid())
  userId String
  tier   AudienceTier
  weight Int
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tier])
  @@index([userId])
}

model UserBudgetPreference {
  id     String     @id @default(cuid())
  userId String
  tier   BudgetTier
  weight Int
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tier])
  @@index([userId])
}

model UserRuntimePreference {
  id     String        @id @default(cuid())
  userId String
  bucket RuntimeBucket
  weight Int
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, bucket])
  @@index([userId])
}

model UserPopularityPreference {
  id     String          @id @default(cuid())
  userId String
  range  PopularityRange
  weight Int
  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, range])
  @@index([userId])
}

// Named, reusable filter presets from the "Aplicar y guardar" button on the
// filter panel -- the same CatalogFilters shape (src/components/explore/
// FilterPanel.tsx) is meaningful on /explore, /recommendations, and
// /wishlist, so a preset isn't scoped to whichever page it was created on.
// `filters` is the whole CatalogFilters object, JSON-serialized -- there's
// no relational precedent in this schema for a struct this shaped (ranges,
// arrays, a nested actor/director pick), and it's only ever read back
// through the same shape it was written in.
model SavedFilter {
  id        String   @id @default(cuid())
  userId    String
  name      String
  filters   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
}

// Cached items from a handful of movie/series news RSS feeds (see
// lib/news.ts) -- shared across every user, not per-account, since the
// articles themselves aren't personal. Refreshed on-demand (whoever opens
// /news first after the cache goes stale triggers the refetch) rather than
// on a schedule, the same lazy-refresh idea used elsewhere in this app
// (Person.detailsFetchedAt, Title.trailerFetchedAt) since there's no
// standalone cron worker here. "Relevant to your taste" is computed at
// request time by matching title/summary against the user's preferred
// actors/directors/genres/titles -- not stored here, so it can't go stale.
model NewsArticle {
  id          String   @id @default(cuid())
  source      String // feed display name, e.g. "Variety"
  title       String
  link        String   @unique
  summary     String?
  imageUrl    String?
  publishedAt DateTime
  fetchedAt   DateTime @default(now())

  @@index([publishedAt])
}
