# Base de datos. Para desarrollo local, dejalo así (archivo SQLite local):
DATABASE_URL="file:./dev.db"
# Para producción (Vercel u otro hosting serverless) usá una base de datos
# Turso (https://turso.tech, gratis) y poné acá la URL que te da:
#   DATABASE_URL="libsql://tu-base-xxxx.turso.io"
#   TURSO_AUTH_TOKEN="el-token-que-genera-turso"
# Es compatible con SQLite (@prisma/adapter-libsql), así que el mismo schema
# y las mismas migraciones funcionan en los dos casos.
TURSO_AUTH_TOKEN=""

# Secreto para firmar las sesiones de NextAuth. Generalo con:
#   openssl rand -base64 32
AUTH_SECRET="reemplazame-con-un-secreto-random"

# Opcional pero recomendado: API Read Access Token (v4) de TMDB.
# Se obtiene gratis en https://www.themoviedb.org/settings/api
# Sin esta variable, `npm run db:seed` carga un catálogo local curado
# (sin pósters) para que la app funcione igual.
TMDB_API_KEY=""
